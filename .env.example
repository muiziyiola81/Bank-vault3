# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE CONFIGURATION: Connects to your existing Supabase project
# Set these in the Secrets panel in AI Studio or in your .env file.
# IMPORTANT: Only use the public/anon key on the frontend; never the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
